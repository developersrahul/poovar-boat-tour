---
// NEERA THEME SECTION 7: ASYMMETRIC LIFESTYLE SHOWCASE ("AUTHENTIC KERALA SANCTUARY")
// High-resolution photography of Poovar backwaters, mangroves & Pozhi beach in edge-to-edge full width
---

<section id="authentic-kerala-sanctuary" class="relative bg-[#fbfcfd] py-20 lg:py-28 overflow-hidden text-[#0d0d0d] border-b border-[#ede8e1] w-full">
  <div class="relative z-10 w-full space-y-12">
    
    <!-- Section Header (Centered with Breathing Room) -->
    <div class="text-center space-y-3 max-w-3xl mx-auto px-4 sm:px-6 neera-reveal flash-frame">
      <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-[#b19d7f] block">
        AUTHENTIC KERALA SANCTUARY
      </span>
      <h2 class="font-marcellus text-3xl sm:text-4xl lg:text-5xl uppercase tracking-[0.14em] text-[#06192e]">
        OUR EXTRAVAGANT POOVAR CRUISE
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed max-w-2xl mx-auto">
        High-definition authentic captures of the serene mangrove canals, golden sand beach estuary, local wildlife, and glowing backwater sunsets.
      </p>
    </div>

    <!-- FULL WIDTH Asymmetric 5-Block Panoramic Grid -->
    <div class="w-full px-0">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch w-full">
        
        <!-- Card 1 (Span 4, Tall): Mangrove Root Canopy -->
        <div class="md:col-span-4 group relative overflow-hidden bg-[#06192e] min-h-[380px] lg:min-h-[480px] neera-reveal flash-frame">
          <img
            src="/images/poovar_mangrove_roots.webp"
            alt="Poovar Mangrove Forest Canals"
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#b19d7f] block font-semibold">MANGROVE FOREST</span>
            <h3 class="font-marcellus text-lg sm:text-xl uppercase tracking-wider text-white">Shaded Natural Tunnels</h3>
          </div>
        </div>

        <!-- Card 2 (Span 8, Wide): Pozhi Estuary Horizon -->
        <div class="md:col-span-8 group relative overflow-hidden bg-[#06192e] min-h-[380px] lg:min-h-[480px] neera-reveal flash-frame">
          <img
            src="/images/poovar_panorama_backwaters.webp"
            alt="Poovar Estuary Horizon & Backwaters"
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#b19d7f] block font-semibold">POZHI ESTUARY &amp; BEACH</span>
            <h3 class="font-marcellus text-xl sm:text-2xl uppercase tracking-wider text-white">Where Neyyar River Meets Arabian Sea</h3>
          </div>
        </div>

        <!-- Card 3 (Span 4): Golden Beach Sandbar -->
        <div class="md:col-span-4 group relative overflow-hidden bg-[#06192e] min-h-[320px] lg:min-h-[400px] neera-reveal flash-frame">
          <img
            src="/images/poovar_sandspit_ocean.webp"
            alt="Golden Sand Beach Sandbar"
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#b19d7f] block font-semibold">GOLDEN SAND SHORE</span>
            <h3 class="font-marcellus text-base sm:text-lg uppercase tracking-wider text-white">Scenic Estuary Sandbar</h3>
          </div>
        </div>

        <!-- Card 4 (Span 4): Exotic Backwater Kingfisher -->
        <div class="md:col-span-4 group relative overflow-hidden bg-[#06192e] min-h-[320px] lg:min-h-[400px] neera-reveal flash-frame">
          <img
            src="/images/poovar_kingfisher.webp"
            alt="Poovar Backwater Kingfisher Wildlife"
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#b19d7f] block font-semibold">WILDLIFE &amp; BIRDS</span>
            <h3 class="font-marcellus text-base sm:text-lg uppercase tracking-wider text-white">Kingfishers &amp; Water Egrets</h3>
          </div>
        </div>

        <!-- Card 5 (Span 4): Sunset Reflections -->
        <div class="md:col-span-4 group relative overflow-hidden bg-[#06192e] min-h-[320px] lg:min-h-[400px] neera-reveal flash-frame">
          <img
            src="/images/poovar_dusk_horizon.webp"
            alt="Poovar Sunset Over Lagoon"
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#b19d7f] block font-semibold">GOLDEN HOUR</span>
            <h3 class="font-marcellus text-base sm:text-lg uppercase tracking-wider text-white">Glowing Evening Skies</h3>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
