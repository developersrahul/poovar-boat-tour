---
// NEERA THEME SECTION 4: ABOUT THE FIRM / SERVICES PROVIDED
// Replicates Neera Yacht's asymmetric photo + 4 feature icons + topographic contours
const phoneNumber = '+917902291301';
---

<section id="about-firm" class="relative bg-neera-contour-lines py-20 lg:py-28 overflow-hidden text-[#0d0d0d] border-b border-[#ede8e1]">
  <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Editorial Manifesto + 4 Nautical Feature Rows -->
      <div class="lg:col-span-6 space-y-7 neera-reveal">
        <span class="text-[11px] font-bold uppercase tracking-[0.25em] text-[#b19d7f] block">
          ABOUT THE FIRM
        </span>

        <h2 class="font-marcellus text-3xl sm:text-4xl lg:text-5xl uppercase tracking-[0.12em] text-[#06192e] leading-[1.18]">
          POOVAR BOATING WITH POOVAR BOAT TOUR
        </h2>

        <!-- Verbatim paragraph from Poovar boat .pdf -->
        <p class="text-sm sm:text-base text-gray-700 leading-relaxed font-light">
          Poovar Boat Tour offers backwater boat rides in Poovar, Thiruvananthapuram, Kerala. One boat carries up to 7 people, so families and friends can ride together.
        </p>
        <p class="text-sm sm:text-base text-gray-700 leading-relaxed font-light">
          Your ride goes through quiet canals lined with mangroves, past the place where the Neyyar River meets the Arabian Sea, and along a golden sand beach. Choose a motor boat cruise, a sunset cruise, a honeymoon cruise or a bird watching cruise. We also run a taxi service for pick-up and drop and for nearby tourist spots.
        </p>

        <!-- Why Choose Poovar Boat Tour (5 Exact Points from PDF) -->
        <div class="pt-2">
          <h3 class="font-marcellus text-sm uppercase tracking-[0.2em] font-bold text-[#06192e] mb-3">
            Why Choose Poovar Boat Tour
          </h3>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>One price per boat.</strong> The price is Rs 1,200 per boat for up to 7 people, so a group shares one simple rate.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Book directly with us.</strong> Book online or call. There is no agent in between.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Four boat cruises.</strong> Choose the motor boat, sunset, honeymoon or bird watching ride.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Taxi service.</strong> We can arrange pick-up, drop and a trip to nearby tourist spots.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Local team.</strong> We work in Poovar, so we know the backwaters and the best time to go.
              </p>
            </div>
          </div>
        </div>

        <!-- Our Boat Cruises (5 Exact Points from PDF) -->
        <div class="pt-2">
          <h3 class="font-marcellus text-sm uppercase tracking-[0.2em] font-bold text-[#06192e] mb-3">
            Our Boat Cruises
          </h3>
          <div class="space-y-2">
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Motor Boat Cruise:</strong> A relaxed ride through the Poovar backwaters and mangroves.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Sunset Cruise:</strong> An evening ride with soft light and cooler air on the water.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Honeymoon Cruise:</strong> A quiet ride for couples.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Bird Watching Cruise:</strong> A slow ride to spot water birds along the mangroves.
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 bg-[#b19d7f] rotate-45 mt-2 flex-shrink-0"></span>
              <p class="text-xs sm:text-sm text-gray-700 font-light leading-relaxed">
                <strong>Taxi Service:</strong> Pick-up, drop and sightseeing trips to nearby places.
              </p>
            </div>
          </div>
          <div class="pt-3">
            <a href="/services/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#b19d7f] hover:text-[#06192e] transition-colors">
              See all cruises <i class="ph-bold ph-arrow-right"></i>
            </a>
          </div>
        </div>

        <!-- Buttons matching Neera (Bronze button + circular dark button) -->
        <div class="pt-4 flex flex-wrap items-center gap-5">
          <a
            href="/pricing/"
            class="px-8 py-3.5 bg-[#b19d7f] hover:bg-[#9e8a6d] text-white font-bold uppercase tracking-[0.18em] text-xs transition duration-300 shadow-lg rounded-[7px]"
          >
            View Packages
          </a>

          <a
            href={`tel:${phoneNumber}`}
            class="flex items-center gap-3 group text-[#06192e] hover:text-[#b19d7f] transition-colors"
          >
            <div class="w-11 h-11 rounded-[7px] bg-[#06192e] group-hover:bg-[#b19d7f] text-white flex items-center justify-center transition-colors shadow-md">
              <i class="ph-fill ph-phone text-base"></i>
            </div>
            <span class="font-marcellus text-xs uppercase tracking-[0.18em] font-bold">
              Call Direct: 79022 91301
            </span>
          </a>
        </div>
      </div>

      <!-- Right Column: Grand Authentic Boat Showcase (Poovar Safari Boat with Guests & Mangrove Forest) -->
      <div class="lg:col-span-6 relative neera-reveal">
        <!-- Single Grand Authentic Cruise Card -->
        <div class="relative overflow-hidden rounded-[7px] shadow-2xl border border-gray-200 group flash-frame">
          <img
            src="/images/about/poovar_original_tourist_boat.webp"
            alt="Poovar Backwaters Safari Boat Cruise with Guests"
            loading="lazy"
            class="w-full h-[450px] sm:h-[540px] lg:h-[620px] object-cover object-[center_35%] filter grayscale-[3%] hover:grayscale-0 transition duration-700 hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-[#06192e]/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity pointer-events-none"></div>
          
          <!-- Badges & Caption -->
          <div class="absolute top-4 left-4 pointer-events-none">
            <span class="inline-block px-3 py-1.5 bg-[#06192e]/90 text-[#b19d7f] border border-[#b19d7f]/40 text-[10px] font-bold uppercase tracking-[0.2em] rounded-[7px] backdrop-blur-sm shadow-md">
              AUTHENTIC FLEET &bull; 7-SEATER MOTOR BOAT
            </span>
          </div>

          <div class="absolute bottom-5 left-5 right-5 text-white pointer-events-none">
            <span class="inline-block px-2.5 py-1 bg-[#b19d7f] text-[#06192e] text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] rounded-[7px] mb-2 font-semibold shadow">
              POOVAR BACKWATERS & MANGROVES
            </span>
            <p class="font-marcellus text-lg sm:text-xl uppercase tracking-[0.14em] text-white font-medium leading-tight">
              Real Safari Boat Experience
            </p>
            <p class="text-xs text-gray-200 font-light mt-1 max-w-md hidden sm:block">
              Glide through serene mangrove root canopies and tranquil backwaters on our certified 7-passenger boats.
            </p>
          </div>
        </div>

        <!-- Subheading Banner at Bottom matching Neera screenshot -->
        <div class="mt-8 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start justify-between gap-4">
          <div>
            <p class="font-marcellus text-xl sm:text-2xl uppercase tracking-[0.18em] text-[#06192e]">
              BEST SAFETY TRAVEL SERVICE.
            </p>
            <p class="text-xs text-gray-600 tracking-[0.08em] mt-1">
              Kerala Maritime Board licensed vessels with certified lifejackets for all 7 guests.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#06192e] text-[#b19d7f] text-[10px] font-bold uppercase tracking-[0.2em] rounded-[7px] whitespace-nowrap border border-[#b19d7f]/30">
            <i class="ph-fill ph-shield-check text-xs text-[#b19d7f]"></i> Certified Safety
          </span>
        </div>
      </div>

    </div>
  </div>
</section>
