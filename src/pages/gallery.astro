---
import Layout from '../layouts/Layout.astro';
import ImageOnlyGallery from '../components/ImageOnlyGallery';

const gallerySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ImageGallery",
      "@id": "https://poovarboattour.com/gallery/#gallery",
      "url": "https://poovarboattour.com/gallery/",
      "name": "Poovar Boat Tour Photo Gallery",
      "description": "High-resolution photographs of Poovar backwaters, Golden Sand Beach estuary, mangrove forest canals, and sunset boat rides.",
      "isPartOf": { "@id": "https://poovarboattour.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://poovarboattour.com/" },
        { "@type": "ListItem", "position": 2, "name": "Gallery", "item": "https://poovarboattour.com/gallery/" }
      ]
    }
  ]
};
---

<Layout
  title="Photo Gallery | Poovar Boat Tour Backwaters & Estuary"
  description="Explore high-resolution authentic photographs of Poovar backwaters, Golden Sand Beach estuary, mangrove forest canopy canals, and sunset boat rides."
  canonicalUrl="https://poovarboattour.com/gallery/"
>
  <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <!-- =====================================================================
       1. HERO SECTION: 90vh Immersive Deep Navy & Bronze Tracking
       ===================================================================== -->
  <section class="relative min-h-[85vh] sm:min-h-[90vh] sm:h-[90vh] w-full flex flex-col justify-center items-center bg-neera-navy-waves bg-[#06192e] text-white pt-36 sm:pt-28 pb-16 sm:pb-12 overflow-hidden border-b border-white/10">
    <div class="relative z-10 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#b19d7f]/20 text-[#b19d7f] text-[11px] font-bold uppercase tracking-[0.25em] border border-[#b19d7f]/30 rounded-[7px]">
        <i class="ph-fill ph-camera text-[#b19d7f]"></i> PURE VISUAL GALLERY • OFFICIAL 11 TOUR ATTRACTIONS • 38 CAPTURES
      </span>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-marcellus text-white uppercase tracking-[0.14em] leading-tight max-w-5xl mx-auto">
        Poovar Backwaters &amp; Boat Tour Gallery
      </h1>

      <p class="mt-4 text-base sm:text-lg md:text-xl text-white/80 max-w-3xl mx-auto font-light leading-relaxed">
        High-definition authentic captures of the serene mangrove canals, golden sand beach estuary, local wildlife, and glowing backwater sunsets.
      </p>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-4 text-xs font-mono uppercase tracking-widest text-[#b19d7f]">
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-image text-[#b19d7f]"></i> High Resolution Photos</span>
        <span>•</span>
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-magnifying-glass-plus text-[#b19d7f]"></i> Click Any Image to Expand</span>
        <span>•</span>
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-sparkle text-[#b19d7f]"></i> 100% Unique Collection</span>
      </div>

      <!-- Downward scroll cue -->
      <div class="pt-8 flex justify-center">
        <a href="#gallery-collection" class="text-white/60 hover:text-white flex flex-col items-center gap-2 text-xs font-mono uppercase tracking-widest transition">
          <span>View Archive</span>
          <i class="ph-bold ph-arrow-down text-sm animate-bounce text-[#b19d7f]"></i>
        </a>
      </div>

    </div>
  </section>

  <!-- =====================================================================
       AWWWARDS-INSPIRED EDITORIAL GALLERY CANVAS (Zero rigid boxes!)
       ===================================================================== -->
  <main id="gallery-collection" class="relative bg-[#faf9f5] text-[#0d0d0d] overflow-hidden">
    
    <!-- Manifesto Section (Centered) -->
    <section class="py-16 sm:py-24 border-b border-[#ede8e1]">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-[#b19d7f] font-bold block text-center">
            THE ARCHIVE • NEYYAR RIVER &amp; POOVAR ESTUARY
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-[#06192e] uppercase tracking-[0.12em] leading-tight text-center mx-auto">
            Witness the Untouched Beauty of Southern Kerala Waters
          </h2>
          <p class="text-base text-gray-700 font-light leading-relaxed text-center mx-auto">
            Every photograph is an authentic unedited view taken from our private boats as they glide through narrow mangrove arches, open estuary lagoons, and the golden sandbanks where the river meets the Arabian Sea.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Editorial Image Gallery Grid with Category Filters -->
    <section class="py-16 sm:py-24 border-b border-[#ede8e1]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <ImageOnlyGallery client:load />
      </div>
    </section>

    <!-- Full-Bleed Panoramic Editorial Showcase Break -->
    <section class="relative bg-neera-navy-waves bg-[#06192e] text-white py-20 lg:py-28 overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 z-0 opacity-25">
        <img
          src="/images/gallery/gallery_08_aerial_golden_sand_beach.webp"
          alt="Pristine Poovar Golden Sand Beach"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#06192e] via-[#06192e]/90 to-[#06192e]/70"></div>
      </div>

      <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl space-y-6">
          <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-[#b19d7f] font-bold block">
            ESTUARY SPOTLIGHT • POZHI CONFLUENCE
          </span>
          <h3 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-white uppercase tracking-[0.12em] leading-tight">
            Where River Meets the Sea
          </h3>
          <p class="text-base sm:text-lg text-white/85 font-light leading-relaxed">
            A narrow spit of virgin golden sand separating the serene freshwater Neyyar backwaters from the turquoise Arabian ocean waves. Experience it firsthand on our standard 2-hour cruise.
          </p>
          <div class="pt-2 flex items-center gap-6">
            <a
              href="/pricing/"
              class="px-8 py-3.5 bg-[#b19d7f] hover:bg-[#9e8a6d] text-white text-xs font-bold uppercase tracking-[0.18em] rounded-[7px] transition-all duration-300 shadow-xl"
            >
              View Cruise Rates &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         RESERVATION BANNER (Awwwards Two-Tone Luxury)
         ===================================================================== -->
    <section class="py-20 lg:py-28 bg-neera-sand-waves bg-[#faf9f5] border-t border-[#ede8e1]">
      <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#b19d7f]/20 text-[#b19d7f] text-xs font-bold uppercase tracking-[0.25em] border border-[#b19d7f]/30 rounded-[7px]">
          <i class="ph-fill ph-compass text-[#b19d7f]"></i> EXPERIENCE IT IN PERSON
        </span>
        <h2 class="text-3xl sm:text-5xl font-marcellus text-[#06192e] uppercase tracking-[0.12em]">
          Ready to Experience Poovar Waters?
        </h2>
        <p class="text-base sm:text-lg text-gray-700 font-light leading-relaxed max-w-2xl mx-auto">
          Reserve your standard 2-hour backwater cruise covering the mangroves, estuary, and beach for Rs 1,200 per boat (up to 7 guests).
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4 text-xs font-bold uppercase tracking-[0.18em]">
          <a
            href="/pricing/"
            class="px-8 py-4 bg-[#06192e] hover:bg-[#b19d7f] text-white rounded-[7px] transition-all duration-300 shadow-xl"
          >
            View Packages &amp; Pricing
          </a>
          <a
            href="/contact/"
            class="px-8 py-4 bg-[#b19d7f] hover:bg-[#9e8a6d] text-white rounded-[7px] transition-all duration-300 shadow-xl"
          >
            Book Now
          </a>
          <a
            href="tel:+917902291301"
            class="px-8 py-4 bg-white hover:bg-[#faf9f5] text-[#06192e] rounded-[7px] border border-[#ede8e1] transition-all duration-300 shadow-sm flex items-center gap-2"
          >
            <i class="ph-bold ph-phone text-[#b19d7f]"></i> Call +91 79022 91301
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>
