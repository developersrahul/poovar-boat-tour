---
import Layout from '../layouts/Layout.astro';

// Exact SEO Metadata from PDF (Page 1)
const pageTitle = "Poovar Boat Service | Backwater Boating Cruises";
const pageDescription = "Poovar boat service with motor boat, sunset, honeymoon and bird watching cruises on the Poovar backwaters. Book your cruise online.";

// Exact 10 FAQs from PDF (Pages 3-4)
const servicesFaqs = [
  {
    num: "01",
    q: "1. What types of boat rides are available in Poovar?",
    a: "Poovar Boat Tour offers four boat rides: a motor boat backwater cruise, a sunset cruise, a honeymoon cruise and a bird watching cruise, each on the Poovar backwaters."
  },
  {
    num: "02",
    q: "2. What is the Poovar backwater cruise?",
    a: "The Poovar backwater cruise is a boat ride through the canals, mangroves and estuary of Poovar in Kerala, where the river meets the Arabian Sea."
  },
  {
    num: "03",
    q: "3. What places are covered on the Poovar boat ride?",
    a: "The ride passes through Poovar's backwaters and mangroves toward the sea mouth and the golden sand beach. The exact stops depend on the tide and your boat driver."
  },
  {
    num: "04",
    q: "4. Can I choose the time of my boat ride?",
    a: "Yes, tell us your date and the time you prefer, and we will confirm a boat for you. Early morning and late afternoon are the most popular times."
  },
  {
    num: "05",
    q: "5. What is the best time for sunset boating in Poovar?",
    a: "The best time for sunset boating in Poovar is the hour before sunset, when the light is soft and the water is calm."
  },
  {
    num: "06",
    q: "6. What time does the Poovar sunset cruise start?",
    a: "The Poovar Boat Tour sunset cruise starts around 5:00 PM and runs until about 6:30 PM. Sunset time changes through the year, so check the time for your date when you book."
  },
  {
    num: "07",
    q: "7. Which is the best boat ride in Poovar for couples?",
    a: "The honeymoon cruise is the best Poovar boat ride for couples. You book the whole boat, so the ride is private for you and your partner, at Rs 1,200 per boat for the 2-hour ride."
  },
  {
    num: "08",
    q: "8. Can I book a private boat in Poovar?",
    a: "Yes, you can book a private boat with Poovar Boat Tour for your own group. You book the whole boat, which carries up to 7 people, at Rs 1,200 for the 2-hour ride."
  },
  {
    num: "09",
    q: "9. Is Poovar good for bird watching?",
    a: "Yes, Poovar's mangroves and backwaters attract water birds, so the early morning cruise suits bird watchers. Your boat driver can help you spot them."
  },
  {
    num: "10",
    q: "10. Which birds can be seen in Poovar?",
    a: "You may see kingfishers, herons and egrets along the Poovar backwaters. Early morning is usually the best time to see them."
  }
];

// Exact Services Schema from PDF
const servicesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://poovarboattour.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://poovarboattour.com/services/" }
      ]
    },
    {
      "@type": "TouristTrip",
      "@id": "https://poovarboattour.com/services/#motor-boat-cruise",
      "name": "Poovar Motor Boat Cruise",
      "description": "A motor boat ride through the backwaters and mangroves of Poovar, Kerala, where the Neyyar River meets the Arabian Sea.",
      "touristType": "Families, couples and friends",
      "provider": { "@id": "https://poovarboattour.com/#business" },
      "offers": {
        "@type": "Offer",
        "price": "1200",
        "priceCurrency": "INR",
        "description": "Per boat, up to 7 people",
        "url": "https://poovarboattour.com/pricing/",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "TouristTrip",
      "@id": "https://poovarboattour.com/services/#sunset-cruise",
      "name": "Poovar Sunset Cruise",
      "description": "An evening boat ride on the Poovar backwaters, timed for the soft light before sunset.",
      "touristType": "Couples, families and photographers",
      "provider": { "@id": "https://poovarboattour.com/#business" }
    },
    {
      "@type": "TouristTrip",
      "@id": "https://poovarboattour.com/services/#honeymoon-cruise",
      "name": "Poovar Honeymoon Boating Cruise in Poovar",
      "description": "A quiet backwater boat ride for couples in Poovar, Kerala.",
      "touristType": "Couples",
      "provider": { "@id": "https://poovarboattour.com/#business" }
    },
    {
      "@type": "TouristTrip",
      "@id": "https://poovarboattour.com/services/#bird-watching-cruise",
      "name": "Poovar Bird Watching Cruise in Poovar",
      "description": "A slow boat ride along the mangroves of Poovar to spot water birds.",
      "touristType": "Nature lovers and photographers",
      "provider": { "@id": "https://poovarboattour.com/#business" }
    },
    {
      "@type": "TaxiService",
      "@id": "https://poovarboattour.com/services/#taxi-service",
      "name": "Poovar Boat Tour Taxi Service and Tourist Spot Pickup",
      "description": "Pick-up, drop and trips to nearby tourist spots.",
      "provider": { "@id": "https://poovarboattour.com/#business" },
      "areaServed": ["Poovar", "Thiruvananthapuram", "Kovalam"]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://poovarboattour.com/services/"
>
  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />

  <!-- =====================================================================
       1. HERO SECTION: Exact H1 & Intro from PDF (Page 1)
       Preserves high top padding for desktop & mobile header separation
       ===================================================================== -->
  <section class="relative min-h-[85vh] sm:min-h-[90vh] sm:h-[90vh] w-full flex flex-col justify-center items-center bg-neera-navy-waves bg-[#06192e] text-white pt-36 sm:pt-28 pb-16 sm:pb-12 overflow-hidden border-b border-white/10">
    <div class="relative z-10 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5 mt-2 sm:mt-0">
      
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#b19d7f]/20 text-[#b19d7f] text-[11px] font-bold uppercase tracking-[0.25em] border border-[#b19d7f]/30 rounded-[7px]">
        <i class="ph-fill ph-compass text-[#b19d7f]"></i> FOUR BACKWATER CRUISES &amp; TAXI SERVICE
      </span>

      <!-- Exact H1 from PDF -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-marcellus text-white uppercase tracking-[0.14em] leading-tight max-w-5xl mx-auto">
        Poovar Boat Service and Backwater Boating Cruises
      </h1>

      <!-- Exact Intro from PDF -->
      <div class="space-y-3 max-w-3xl mx-auto">
        <p class="text-base sm:text-lg md:text-xl text-white/90 font-light leading-relaxed">
          Poovar Boat Tour is a Poovar boat service offering four backwater cruises, plus a taxi service. Every boat carries up to 7 people, and the price is Rs 1,200 per boat.
        </p>
        <p class="text-sm sm:text-base text-white/75 font-light leading-relaxed">
          Pick the cruise that fits your trip. All of them travel through the calm waters of Poovar, Thiruvananthapuram, Kerala.
        </p>
      </div>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-4 text-xs font-mono uppercase tracking-widest text-[#b19d7f]">
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-users text-[#b19d7f]"></i> Up to 7 People per Boat</span>
        <span>•</span>
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-currency-inr text-[#b19d7f]"></i> Rs 1,200 per Boat</span>
        <span>•</span>
        <span class="flex items-center gap-1.5"><i class="ph-bold ph-map-pin text-[#b19d7f]"></i> Poovar, Thiruvananthapuram, Kerala</span>
      </div>

      <!-- Downward scroll cue -->
      <div class="pt-8 flex justify-center">
        <a href="#services-portfolio" class="text-white/60 hover:text-white flex flex-col items-center gap-2 text-xs font-mono uppercase tracking-widest transition">
          <span>Explore Cruises</span>
          <i class="ph-bold ph-arrow-down text-sm animate-bounce text-[#b19d7f]"></i>
        </a>
      </div>

    </div>
  </section>

  <!-- =====================================================================
       EDITORIAL SERVICES PORTFOLIO: Exact Content from PDF
       ===================================================================== -->
  <main id="services-portfolio" class="relative bg-[#faf9f5] text-[#0d0d0d] overflow-hidden">
    
    <!-- Intro Sub-banner from PDF -->
    <section class="py-14 sm:py-20 border-b border-[#ede8e1]">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center space-y-5">
          <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-[#b19d7f] font-bold block text-center">
            NEYYAR ESTUARY &amp; MANGROVE SANCTUARY
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-marcellus text-[#06192e] uppercase tracking-[0.12em] leading-snug text-center mx-auto max-w-3xl">
            Pick the cruise that fits your trip. All of them travel through the calm waters of Poovar, Thiruvananthapuram, Kerala.
          </h2>
          <div class="flex flex-wrap items-center justify-center gap-3 pt-3 text-xs font-mono uppercase tracking-wider text-gray-600">
            <span class="px-3.5 py-1.5 bg-white border border-[#ede8e1] rounded-[7px] shadow-2xs">🛶 Calm Waters</span>
            <span class="px-3.5 py-1.5 bg-white border border-[#ede8e1] rounded-[7px] shadow-2xs">🌿 Mangrove Canals</span>
            <span class="px-3.5 py-1.5 bg-white border border-[#ede8e1] rounded-[7px] shadow-2xs">🌅 Sunset Horizon</span>
            <span class="px-3.5 py-1.5 bg-white border border-[#ede8e1] rounded-[7px] shadow-2xs">📍 Attupuram Jetty</span>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CRUISE 01: POOVAR MOTOR BOAT CRUISE (Exact PDF Content - Page 1)
         ===================================================================== -->
    <section id="motor-boat-cruise" class="py-20 lg:py-28 border-b border-[#ede8e1]">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Text Narrative -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="font-marcellus text-4xl sm:text-5xl text-[#b19d7f] font-bold block">
                01
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.22em] text-[#b19d7f] font-bold block">
                MAIN BACKWATER RIDE • UP TO 7 PEOPLE
              </span>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-[#06192e] uppercase tracking-[0.12em]">
                Poovar Motor Boat Cruise
              </h3>
            </div>

            <!-- Exact Verbatim Text from PDF -->
            <div class="space-y-4 text-sm sm:text-base text-gray-700 leading-relaxed font-light">
              <p>
                The Poovar motor boat cruise is our main backwater ride. It takes you through the canals and mangroves of Poovar in Kerala, toward the place where the river meets the sea.
              </p>
              <p>
                The ride is relaxed and suits families, friends and first-time visitors. You book the whole boat, so your group rides together. The standard ride is 2 hours, and a 1-hour ride is also available.
              </p>
              <p class="text-xs sm:text-sm text-gray-600 pl-4 border-l-2 border-[#b19d7f]">
                On this route you usually pass mangrove channels, fishing villages, the river mouth and the golden sand beach. The exact stops depend on the tide and your boat driver, so ask your driver what you will see.
              </p>
            </div>

            <!-- Price & Direct Action from PDF -->
            <div class="pt-4 flex flex-wrap items-center justify-between gap-6 border-t border-[#ede8e1]">
              <div>
                <span class="text-2xl sm:text-3xl font-marcellus text-[#06192e] font-bold block">
                  Rs 1,200 <span class="text-xs font-mono font-normal text-gray-500">/ boat</span>
                </span>
                <span class="text-xs font-mono text-gray-500 block">
                  Price: Rs 1,200 per boat for the 2-hour ride, up to 7 people
                </span>
              </div>
              <button
                type="button"
                onclick="openBookingModal('Service: Poovar Motor Boat Cruise')"
                class="px-8 py-3.5 bg-[#06192e] hover:bg-[#b19d7f] text-white font-bold text-xs uppercase tracking-[0.18em] transition rounded-[7px] shadow-lg cursor-pointer"
              >
                Book the Motor Boat Cruise
              </button>
            </div>
          </div>

          <!-- Visual Frame -->
          <div class="lg:col-span-5 relative">
            <div class="relative overflow-hidden rounded-[7px] shadow-2xl border border-white group">
              <img
                src="/images/services/motor_boat_cruise.webp"
                alt="Poovar Motor Boat Cruise"
                loading="lazy"
                class="w-full h-80 sm:h-[460px] lg:h-[520px] object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-widest text-[#b19d7f] block font-bold">
                  CANALS • MANGROVES • ESTUARY • BEACH
                </span>
                <span class="font-marcellus text-sm uppercase tracking-wider text-white block">
                  Signature Neyyar Estuary Passage
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================================
         CRUISE 02: POOVAR SUNSET CRUISE (Exact PDF Content - Page 1)
         ===================================================================== -->
    <section id="sunset-cruise" class="py-20 lg:py-28 bg-neera-navy-waves bg-[#06192e] text-white border-b border-white/10">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Visual Frame -->
          <div class="lg:col-span-5 relative order-2 lg:order-1">
            <div class="relative overflow-hidden rounded-[7px] shadow-2xl border border-[#b19d7f]/30 group">
              <img
                src="/images/services/sunset_cruise.webp"
                alt="Poovar Sunset Cruise"
                loading="lazy"
                class="w-full h-80 sm:h-[460px] lg:h-[520px] object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#06192e]/90 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-widest text-[#b19d7f] block font-bold">
                  5:00 PM – 6:30 PM • GOLDEN HOUR
                </span>
                <span class="font-marcellus text-sm uppercase tracking-wider text-white block">
                  Arabian Sea Horizon Sunset
                </span>
              </div>
            </div>
          </div>

          <!-- Text Narrative -->
          <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
            <div class="space-y-2">
              <span class="font-marcellus text-4xl sm:text-5xl text-[#b19d7f] font-bold block">
                02
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.22em] text-[#b19d7f] font-bold block">
                EVENING LIGHT &amp; REFLECTIONS • 5:00 PM – 6:30 PM
              </span>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-white uppercase tracking-[0.12em]">
                Poovar Sunset Cruise
              </h3>
            </div>

            <!-- Exact Verbatim Text from PDF -->
            <div class="space-y-4 text-sm sm:text-base text-white/85 leading-relaxed font-light">
              <p>
                The Poovar sunset cruise is an evening boat ride timed for the soft light before sunset. The air is cooler, and the water and sky change colour.
              </p>
              <p>
                It is a good ride for couples, families and photographers. The cruise starts around 5:00 PM and runs until about 6:30 PM. Sunset time changes through the year, so tell us your date and we will confirm the right slot.
              </p>
            </div>

            <!-- Price & Direct Action from PDF -->
            <div class="pt-4 flex flex-wrap items-center justify-between gap-6 border-t border-white/15">
              <div>
                <span class="text-2xl sm:text-3xl font-marcellus text-white font-bold block">
                  Rs 1,200 <span class="text-xs font-mono font-normal text-white/60">/ boat</span>
                </span>
                <span class="text-xs font-mono text-white/60 block">
                  Price: Rs 1,200 per boat, up to 7 people
                </span>
              </div>
              <button
                type="button"
                onclick="openBookingModal('Service: Poovar Sunset Cruise')"
                class="px-8 py-3.5 bg-[#b19d7f] hover:bg-[#9e8a6d] text-white font-bold text-xs uppercase tracking-[0.18em] transition rounded-[7px] shadow-lg cursor-pointer"
              >
                Book the Sunset Cruise
              </button>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================================
         CRUISE 03: HONEYMOON BOATING CRUISE IN POOVAR (Exact PDF Content - Page 1-2)
         ===================================================================== -->
    <section id="honeymoon-cruise" class="py-20 lg:py-28 border-b border-[#ede8e1]">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Text Narrative -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="font-marcellus text-4xl sm:text-5xl text-[#b19d7f] font-bold block">
                03
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.22em] text-[#b19d7f] font-bold block">
                PRIVATE &amp; ROMANTIC • COUPLES EXCURSION
              </span>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-[#06192e] uppercase tracking-[0.12em]">
                Honeymoon Boating Cruise in Poovar
              </h3>
            </div>

            <!-- Exact Verbatim Text from PDF -->
            <div class="space-y-4 text-sm sm:text-base text-gray-700 leading-relaxed font-light">
              <p>
                The honeymoon cruise is a quiet backwater ride for couples who want some time on the water by themselves.
              </p>
              <p>
                Because you book the whole boat, you have the boat to yourselves. Early morning and sunset are the most peaceful times for a couple's ride.
              </p>
            </div>

            <!-- Price & Direct Action from PDF -->
            <div class="pt-4 flex flex-wrap items-center justify-between gap-6 border-t border-[#ede8e1]">
              <div>
                <span class="text-2xl sm:text-3xl font-marcellus text-[#06192e] font-bold block">
                  Rs 1,200 <span class="text-xs font-mono font-normal text-gray-500">/ boat</span>
                </span>
                <span class="text-xs font-mono text-gray-500 block">
                  Price: Rs 1,200 per boat for the 2-hour ride
                </span>
              </div>
              <button
                type="button"
                onclick="openBookingModal('Service: Honeymoon Boating Cruise')"
                class="px-8 py-3.5 bg-[#06192e] hover:bg-[#b19d7f] text-white font-bold text-xs uppercase tracking-[0.18em] transition rounded-[7px] shadow-lg cursor-pointer"
              >
                Book the Honeymoon Cruise
              </button>
            </div>
          </div>

          <!-- Visual Frame -->
          <div class="lg:col-span-5 relative">
            <div class="relative overflow-hidden rounded-[7px] shadow-2xl border border-white group">
              <img
                src="/images/services/honeymoon_cruise.webp"
                alt="Honeymoon Boating Cruise in Poovar"
                loading="lazy"
                class="w-full h-80 sm:h-[460px] lg:h-[520px] object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-widest text-[#b19d7f] block font-bold">
                  SECLUDED MANGROVE CHANNELS
                </span>
                <span class="font-marcellus text-sm uppercase tracking-wider text-white block">
                  Intimate Private Couple Charter
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================================
         CRUISE 04: BIRD WATCHING CRUISE IN POOVAR (Exact PDF Content - Page 2)
         ===================================================================== -->
    <section id="bird-watching-cruise" class="py-20 lg:py-28 border-b border-[#ede8e1] bg-white">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Visual Frame -->
          <div class="lg:col-span-5 relative order-2 lg:order-1">
            <div class="relative overflow-hidden rounded-[7px] shadow-2xl border border-gray-200 group">
              <img
                src="/images/services/bird_watching_cruise.webp"
                alt="Bird Watching Cruise in Poovar"
                loading="lazy"
                class="w-full h-80 sm:h-[460px] lg:h-[520px] object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white space-y-1">
                <span class="text-[10px] font-mono uppercase tracking-widest text-[#b19d7f] block font-bold">
                  KINGFISHERS • HERONS • EGRETS
                </span>
                <span class="font-marcellus text-sm uppercase tracking-wider text-white block">
                  Early Morning Mangrove Sanctuary
                </span>
              </div>
            </div>
          </div>

          <!-- Text Narrative -->
          <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
            <div class="space-y-2">
              <span class="font-marcellus text-4xl sm:text-5xl text-[#b19d7f] font-bold block">
                04
              </span>
              <span class="text-[11px] font-mono uppercase tracking-[0.22em] text-[#b19d7f] font-bold block">
                BIRD WATCHING &amp; WILDLIFE • EARLY MORNING DEPARTURES
              </span>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-marcellus text-[#06192e] uppercase tracking-[0.12em]">
                Bird Watching Cruise in Poovar
              </h3>
            </div>

            <!-- Exact Verbatim Text from PDF -->
            <div class="space-y-4 text-sm sm:text-base text-gray-700 leading-relaxed font-light">
              <p>
                Poovar is good for bird watching because the mangroves and backwaters are home to water birds. The bird watching cruise moves slowly so you can look and take photos.
              </p>
              <p>
                Birds often seen here include kingfishers, herons and egrets. Early morning is usually the best time, when the birds are most active. Your boat driver can help you spot them.
              </p>
            </div>

            <!-- Direct Action Button from PDF -->
            <div class="pt-4 flex flex-wrap items-center justify-between gap-6 border-t border-[#ede8e1]">
              <div>
                <span class="text-2xl sm:text-3xl font-marcellus text-[#06192e] font-bold block">
                  Rs 1,200 <span class="text-xs font-mono font-normal text-gray-500">/ boat</span>
                </span>
